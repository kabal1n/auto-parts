generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum ReorderStatus {
  ACTIVE
  PROCESSED
}

enum ReceiptStatus {
  DRAFT
  READY
  POSTED
  CANCELLED
}

model Role {
  role_id Int    @id @default(autoincrement())
  name    String @unique @db.VarChar(50)

  users User[]
}

model User {
  user_id        Int        @id @default(autoincrement())
  login          String     @unique @db.VarChar(100)
  password_hash  String     @db.VarChar(255)
  account_status UserStatus @default(ACTIVE)
  role_id        Int
  last_name      String     @db.VarChar(100)
  first_name     String     @db.VarChar(100)
  middle_name    String?    @db.VarChar(100)
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt

  role          Role            @relation(fields: [role_id], references: [role_id])
  action_logs   ActionLog[]
  sales         Sale[]
  orders        CustomerOrder[]
  receipts      GoodsReceipt[]
  reorder_requests        ReorderRequest[]
  receipt_issues_resolved ReceiptIssue[] @relation("IssueResolver")
}

model ActionLog {
  log_id         Int      @id @default(autoincrement())
  event_datetime DateTime @default(now())
  user_id        Int
  action_type    String   @db.VarChar(50)
  entity_name    String   @db.VarChar(100)
  entity_id      Int?
  description    String?  @db.Text

  user User @relation(fields: [user_id], references: [user_id])
}

model Store {
  store_id Int    @id @default(autoincrement())
  name     String @db.VarChar(200)

  stock    StockByStore[]
  sales    Sale[]
  orders   CustomerOrder[]
  receipts GoodsReceipt[]
  reorder_requests ReorderRequest[]
}

model Supplier {
  supplier_id Int            @id @default(autoincrement())
  name        String         @db.VarChar(200)
  xls_config  Json
  receipts    GoodsReceipt[]
}

model Category {
  category_id    Int      @id @default(autoincrement())
  name           String   @unique @db.VarChar(150)
  markup_percent Decimal  @default(50) @db.Decimal(5, 2)
  products       Product[]
}

model Manufacturer {
  manufacturer_id Int      @id @default(autoincrement())
  name            String   @unique @db.VarChar(150)
  products        Product[]
}

model Unit {
  unit_id  Int      @id @default(autoincrement())
  name     String   @unique @db.VarChar(50)
  products Product[]
}

model Product {
  product_id      Int      @id @default(autoincrement())
  name            String   @db.VarChar(300)
  article         String?  @db.VarChar(100)
  barcode         String?  @unique @db.VarChar(50)
  category_id     Int?
  manufacturer_id Int?
  unit_id         Int?
  price           Decimal  @db.Decimal(10, 2)
  description     String?  @db.Text
  image_path      String?  @db.VarChar(500)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  category     Category?     @relation(fields: [category_id],     references: [category_id])
  manufacturer Manufacturer? @relation(fields: [manufacturer_id], references: [manufacturer_id])
  unit         Unit?         @relation(fields: [unit_id],         references: [unit_id])
  stock           StockByStore[]
  sale_items      SaleItem[]
  order_items     CustomerOrderItem[]
  receipt_items   GoodsReceiptItem[]
  reorder_items   ReorderItem[]
}

model StockByStore {
  stock_id          Int @id @default(autoincrement())
  store_id          Int
  product_id        Int
  quantity          Int @default(0)
  minimum_quantity  Int @default(0)
  reserved_quantity Int @default(0)

  store   Store   @relation(fields: [store_id], references: [store_id])
  product Product @relation(fields: [product_id], references: [product_id])

  @@unique([store_id, product_id])
}

model CustomerStatus {
  client_status_id         Int     @id @default(autoincrement())
  name                     String  @db.VarChar(100)
  default_discount_percent Decimal @default(0) @db.Decimal(5, 2)

  customers Customer[]
}

model Customer {
  client_id                Int      @id @default(autoincrement())
  client_status_id         Int
  personal_discount_percent Decimal @default(0) @db.Decimal(5, 2)
  last_name                String   @db.VarChar(100)
  first_name               String   @db.VarChar(100)
  middle_name              String?  @db.VarChar(100)
  phone                    String   @unique @db.VarChar(30)
  comment                  String?  @db.Text
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  status  CustomerStatus  @relation(fields: [client_status_id], references: [client_status_id])
  cars    Car[]
  sales   Sale[]
  orders  CustomerOrder[]
}

model Car {
  car_id    Int     @id @default(autoincrement())
  client_id Int
  car_brand String  @db.VarChar(100)
  car_model String  @db.VarChar(100)
  car_year  Int?
  vin       String? @db.VarChar(20)

  customer Customer       @relation(fields: [client_id], references: [client_id])
  orders   CustomerOrder[]
}

model Sale {
  sale_id          Int      @id @default(autoincrement())
  sale_datetime    DateTime @default(now())
  subtotal_amount  Decimal  @db.Decimal(10, 2)
  discount_percent Decimal  @default(0) @db.Decimal(5, 2)
  discount_amount  Decimal  @default(0) @db.Decimal(10, 2)
  total_amount     Decimal  @db.Decimal(10, 2)
  cash_amount      Decimal  @default(0) @db.Decimal(10, 2)
  card_amount      Decimal  @default(0) @db.Decimal(10, 2)
  change_amount    Decimal  @default(0) @db.Decimal(10, 2)
  user_id          Int
  store_id         Int
  client_id        Int?

  user     User      @relation(fields: [user_id], references: [user_id])
  store    Store     @relation(fields: [store_id], references: [store_id])
  customer Customer? @relation(fields: [client_id], references: [client_id])
  items    SaleItem[]
}

model SaleItem {
  sale_item_id Int     @id @default(autoincrement())
  sale_id      Int
  product_id   Int
  quantity     Int
  price        Decimal @db.Decimal(10, 2)
  line_amount  Decimal @db.Decimal(10, 2)

  sale    Sale    @relation(fields: [sale_id], references: [sale_id])
  product Product @relation(fields: [product_id], references: [product_id])
}

model CustomerOrderStatus {
  order_status_id Int    @id @default(autoincrement())
  name            String @db.VarChar(100)

  orders CustomerOrder[]
}

model CustomerOrder {
  customer_order_id Int      @id @default(autoincrement())
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  subtotal_amount   Decimal  @default(0) @db.Decimal(10, 2)
  discount_percent  Decimal  @default(0) @db.Decimal(5, 2)
  discount_amount   Decimal  @default(0) @db.Decimal(10, 2)
  total_amount      Decimal  @db.Decimal(10, 2)
  prepayment_amount Decimal  @default(0) @db.Decimal(10, 2)
  amount_due        Decimal  @db.Decimal(10, 2)
  expected_date     DateTime? @db.Date
  notes             String?  @db.Text
  client_id         Int
  user_id           Int
  store_id          Int
  order_status_id   Int
  car_id            Int?

  customer Customer            @relation(fields: [client_id], references: [client_id])
  user     User                @relation(fields: [user_id], references: [user_id])
  store    Store               @relation(fields: [store_id], references: [store_id])
  status   CustomerOrderStatus @relation(fields: [order_status_id], references: [order_status_id])
  car      Car?                @relation(fields: [car_id], references: [car_id])
  items    CustomerOrderItem[]
}

model CustomerOrderItem {
  customer_order_item_id Int     @id @default(autoincrement())
  customer_order_id      Int
  product_id             Int
  quantity               Int
  price                  Decimal @db.Decimal(10, 2)
  line_amount            Decimal @db.Decimal(10, 2)

  order   CustomerOrder @relation(fields: [customer_order_id], references: [customer_order_id])
  product Product       @relation(fields: [product_id], references: [product_id])
}

model GoodsReceipt {
  receipt_id       Int           @id @default(autoincrement())
  receipt_datetime DateTime      @default(now())
  note             String?       @db.Text
  user_id          Int
  store_id         Int
  supplier_id      Int?
  status           ReceiptStatus @default(DRAFT)
  file_name        String?       @db.VarChar(500)

  user     User               @relation(fields: [user_id],     references: [user_id])
  store    Store              @relation(fields: [store_id],    references: [store_id])
  supplier Supplier?          @relation(fields: [supplier_id], references: [supplier_id])
  items    GoodsReceiptItem[]
  issues   ReceiptIssue[]
}

model GoodsReceiptItem {
  receipt_item_id      Int     @id @default(autoincrement())
  receipt_id           Int
  product_id           Int?
  quantity             Int
  purchase_price       Decimal @db.Decimal(10, 2)
  sale_price           Decimal @db.Decimal(10, 2)
  match_status         String  @default("pending") @db.VarChar(20)
  raw_article          String? @db.VarChar(100)
  raw_name             String? @db.VarChar(300)
  raw_barcode          String? @db.VarChar(50)
  raw_manufacturer     String? @db.VarChar(150)

  receipt GoodsReceipt  @relation(fields: [receipt_id], references: [receipt_id])
  product Product?      @relation(fields: [product_id], references: [product_id])
  issues  ReceiptIssue[]
}

model ReceiptIssue {
  issue_id        Int       @id @default(autoincrement())
  receipt_id      Int
  receipt_item_id Int?
  created_at      DateTime  @default(now())
  reason          String    @db.VarChar(200)
  comment         String?   @db.Text
  is_resolved     Boolean   @default(false)
  resolved_at     DateTime?
  resolved_by_id  Int?

  receipt      GoodsReceipt      @relation(fields: [receipt_id],      references: [receipt_id])
  receipt_item GoodsReceiptItem? @relation(fields: [receipt_item_id], references: [receipt_item_id])
  resolved_by  User?             @relation("IssueResolver", fields: [resolved_by_id], references: [user_id])
}

model ReorderRequest {
  reorder_request_id Int           @id @default(autoincrement())
  created_at         DateTime      @default(now())
  comment            String?       @db.Text
  status             ReorderStatus @default(ACTIVE)
  store_id           Int
  user_id            Int

  store Store         @relation(fields: [store_id], references: [store_id])
  user  User          @relation(fields: [user_id], references: [user_id])
  items ReorderItem[]
}

model ReorderItem {
  item_id            Int @id @default(autoincrement())
  reorder_request_id Int
  product_id         Int
  required_quantity  Int

  request ReorderRequest @relation(fields: [reorder_request_id], references: [reorder_request_id], onDelete: Cascade)
  product Product        @relation(fields: [product_id], references: [product_id])
}
